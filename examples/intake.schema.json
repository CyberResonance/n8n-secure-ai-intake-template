{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/intake-classification.json",
  "title": "Intake Classification",
  "description": "The strict contract the LLM output must satisfy before anything downstream is allowed to run. The 'Validate Against JSON Schema' Code node enforces this exact shape; any deviation is dead-lettered, never propagated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["category", "priority", "summary", "confidence"],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["bug", "feature", "question", "abuse"]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
