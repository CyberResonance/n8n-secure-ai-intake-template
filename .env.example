# ---------------------------------------------------------------------------
# Signed AI Intake Template - environment configuration
# ---------------------------------------------------------------------------
# Copy to `.env`, fill in REAL values locally, and NEVER commit the real .env.
# This template reads every secret from the environment only - there are zero
# hardcoded credentials anywhere in the workflow JSON (Law 2 / secret hygiene).
#
# In self-hosted n8n these are exposed to expressions as {{ $env.NAME }} only
# when N8N_BLOCK_ENV_ACCESS_IN_NODE=false. Recent n8n versions block env access
# by default; the bundled docker-compose.yml sets it (plus
# NODE_FUNCTION_ALLOW_BUILTIN=crypto for the HMAC guard). See docs/runbook.md.
# ---------------------------------------------------------------------------

# --- PILLAR 1: webhook signature verification -------------------------------
# Shared secret used to compute/verify the HMAC-SHA256 request signature.
# Generate a strong random value, e.g.:  openssl rand -hex 32
WEBHOOK_SIGNING_SECRET=replace-with-openssl-rand-hex-32

# --- PILLAR 2: LLM extraction + schema validation ---------------------------
# OpenAI-compatible chat-completions endpoint. Works with OpenAI, Anthropic via
# an OpenAI-compatible proxy, or a LOCAL model (Ollama: http://host.docker.internal:11434/v1).
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=gpt-4o-mini

# --- PILLAR 3: dead-letter alerting -----------------------------------------
# Slack Incoming Webhook URL (body = { "text": ... }), OR a Telegram bot
# sendMessage URL. If you use Telegram, adjust the "Alert" node body to
# { "chat_id": "...", "text": ... } - see docs/dead-letter-and-replay.md.
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOURS

# Public base URL of your n8n instance - used to build a clickable execution
# link inside each dead-letter alert. No trailing slash.
N8N_BASE_URL=https://n8n.example.com
